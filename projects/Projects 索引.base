filters:
  and:
    - file.inFolder("projects")
views:
  - type: table
    name: 按创建时间
    order:
      - file.name
      - domain
      - topic
      - status
      - created
      - repo
    sort:
      - property: created
        direction: DESC
    columnSize:
      file.name: 277
  - type: table
    name: 按领域分组
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - topic
      - status
      - created
    sort:
      - property: created
        direction: DESC
